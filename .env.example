# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Meta Model API (primary): create a key at dev.meta.ai/platform -> API keys
COMARTIST_META_API_KEY=
# Defaults already match the docs; override only if Meta changes them:
# COMARTIST_META_BASE_URL=https://api.meta.ai/v1
# COMARTIST_META_TEXT_MODEL_IDS={"Muse Wonder":"muse-wonder-1.0"}
# COMARTIST_META_IMAGE_MODEL_IDS={"Muse Image":"muse-image-1.0"}

# Fireworks (text fallback when Meta credits run out)
COMARTIST_FIREWORKS_API_KEY=

# Modal (not wired up yet)
COMARTIST_MODAL_TOKEN=
